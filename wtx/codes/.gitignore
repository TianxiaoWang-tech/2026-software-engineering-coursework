# ---- 大型外部源码（Home Assistant 浅克隆，约 256 MB / 3 万个文件）----
# 不作为项目代码纳入版本控制。需要时重新拉取：
#   git clone --depth=1 https://github.com/home-assistant/core.git core
# 仅忽略仓库根目录的 HA 克隆，避免误伤 gateway/core（内核源码）
/core/

# ---- 构建产物与依赖 ----
build-output/
node_modules/
oh_modules/
.hvigor/
build/
dist/
*.hap
*.app
*.hsp

# ---- 签名凭据（本机 DevEco 自动签名生成，含个人证书口令，绝不入库）----
mobile/signing.local.json5
signing.local.json5

# ---- 运行时产物（密钥库等，绝不入库）----
.runtime/
*.key
!**/test-fixtures/**/*.key

# ---- 日志与临时文件 ----
*.log
*.tmp
*.bak
~$*
.DS_Store
Thumbs.db

# ---- Python ----
__pycache__/
*.py[cod]
.venv/

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
